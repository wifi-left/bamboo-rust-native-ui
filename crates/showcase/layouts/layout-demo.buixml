      <run text="夜曲" style="strong"/>
      <run text="查看" style="link" link="7"/>
    </widget>
    <widget id="m7_spark" x="pad" y="1698" w="cw-2*pad" h="36" color="accent" gap="3">
      <point value="1"/>
      <point value="3.5"/>
      <point value="4"/>
